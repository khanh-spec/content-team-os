# --- Supabase (Project Settings → API) -------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated email domains allowed to sign in (empty = anyone Supabase lets in)
ALLOWED_EMAIL_DOMAINS=headsonpillows.com

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_WRITER_MODEL=gpt-5.5        # rewriting, fact-checking, synthesis
# OPENAI_FAST_MODEL=gpt-5.4-mini     # fan-outs, mention extraction
# OPENAI_CHATGPT_MODEL=gpt-5.5       # model used to simulate ChatGPT answers (web search on)

# --- SerpApi ----------------------------------------------------------------
SERPAPI_API_KEY=

# --- Optional: store an OpenAI key from the Settings page (encrypted) ---------
# SUPABASE_SERVICE_ROLE_KEY=
# SETTINGS_ENCRYPTION_KEY=any-long-random-string
